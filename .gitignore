# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# CA pública del Postgres de producción, fijada para TLS verify-ca del backup (docs/backups.md)
!.github/backup/prod-postgres-root-ca.pem

# Estado y reportes locales del importador del historial (npm run historial:importar)
.historial/

# Datos de clientes y respaldos: nunca al repo (revisión de seguridad, 28-sep-2026).
# Exports de GHL, dumps de Postgres, respaldos cifrados y la carpeta del ensayo de restore.
*.csv
*.dump
*.sql.gz
*.gpg
/restore/

# Llaves y credenciales locales
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
.npmrc
