DATABASE_URL=
REDIS_URL=
AUTH_SECRET=
APP_URL=http://localhost:3000

# Rate limiter por IP (lib/rate-limit). Todos opcionales; defaults en config.ts.
# RATE_LIMIT_XFF_INDEX: posición de la IP de cliente en x-forwarded-for
# (0 = primera, la que escribe el edge de Railway; negativo = desde la derecha).
RATE_LIMIT_XFF_INDEX=0
RATE_LIMIT_AUTH_MAX=120
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_SIGNIN_MAX=20
RATE_LIMIT_SIGNIN_WINDOW_SECONDS=900
# Solo para tests de concurrencia/carga contra Redis real (nunca prod).
REDIS_TEST_URL=

# Canal WhatsApp vía Zernio (lib/messaging). Web (webhook) y worker.
ZERNIO_API_KEY=
ZERNIO_WEBHOOK_SECRET=
# Opcional; default https://zernio.com/api
ZERNIO_BASE_URL=
# OBLIGATORIA (falla cerrado): accountId(s) de Zernio que acepta este entorno,
# separados por coma. Staging: el sandbox. Producción: el número real.
ZERNIO_ALLOWED_ACCOUNT_IDS=

# Bucket de media (Railway Storage Bucket, compatible con S3). Web y worker.
# Sin ellas el worker sigue ingiriendo mensajes; solo la media queda pendiente.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
